<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <Style src="UIController.uss" />
    <ui:Template src="/Assets/UI/InputField/InputFieldTemplate.uxml" name="InputField"/>
    <ui:VisualElement>
        <ui:Label text="Score: 0" name="score" class="score" />
    </ui:VisualElement>
    <ui:VisualElement name="fields" class="fields">
        <ui:Instance template="InputField" name="diceCountField">
            <ui:AttributeOverrides element-name="inputField" label="Dice count" />
        </ui:Instance>
        <ui:Instance template="InputField" name="drawValueField">
            <ui:AttributeOverrides element-name="inputField" label="Draw points" />
        </ui:Instance>
        <ui:Instance template="InputField" name="failValueField">
            <ui:AttributeOverrides element-name="inputField" label="Fail points" />
        </ui:Instance>
        <ui:Instance template="InputField" name="victoryValueField">
            <ui:AttributeOverrides element-name="inputField" label="Success points" />
        </ui:Instance>
    </ui:VisualElement>
    <ui:VisualElement class="rollButtonContainer">
        <ui:Button name="rollButton" class="rollButton" text="Roll dices" />
    </ui:VisualElement>
</ui:UXML>