.labels {
    font-size: 60px;
    padding: 20px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.hidden {
    display: none;
}

.fail {
    color: red;
}

.success {
    color: green;
}

.draw {
    color: yellow;
}

.fields {
    width: 500px;
    position: relative;
    top: 500px;
    left: 20px;
}

.rollButton {
    position: relative;
    top: 500px;
    left: 750px;
    background-color: aqua;
    border-radius: 8px;
    font-size: 40px;
    width: 500px;
    height: 80px;
}