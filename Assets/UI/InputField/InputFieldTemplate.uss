.inputField {
    margin-bottom: 20px;
}

.integerField {
    display: flex;
    justify-content: space-between;
    font-size: 40px;
    width: 100%;
}

.unity-integer-field__input {
    background-color: rgb(255, 255, 250);
    border-radius: 8px;
    border-color: transparent;
    height: 80px;
    width: 100px;
}

.unity-integer-field__label {
    flex-grow: 1;
}